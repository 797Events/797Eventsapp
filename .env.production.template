# 797 Events - Production Environment Variables
# Copy this file to .env.local and fill in your production values

# =============================================================================
# SUPABASE CONFIGURATION (REQUIRED)
# =============================================================================
# Get these from your Supabase project dashboard
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# =============================================================================
# PAYMENT GATEWAY (REQUIRED FOR BOOKINGS)
# =============================================================================
# Razorpay Live Credentials (replace test keys)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_YOUR_LIVE_KEY"
RAZORPAY_KEY_SECRET="YOUR_LIVE_SECRET"

# =============================================================================
# SECURITY KEYS (GENERATE NEW STRONG KEYS)
# =============================================================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="YOUR_STRONG_256_BIT_SECRET"
QR_SECRET_KEY="YOUR_UNIQUE_QR_SECRET"

# =============================================================================
# EMAIL SERVICE (REQUIRED FOR TICKET DELIVERY)
# =============================================================================
# Gmail Configuration (recommended)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-business-email@gmail.com"
SMTP_PASS="your-app-password"  # Gmail App Password, not regular password
SMTP_FROM="797events@your-domain.com"

# Alternative: SendGrid (if preferred over Gmail)
# SMTP_HOST="smtp.sendgrid.net"
# SMTP_PORT="587"
# SMTP_USER="apikey"
# SMTP_PASS="YOUR_SENDGRID_API_KEY"

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
NODE_ENV="production"
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# =============================================================================
# OPTIONAL: EXTERNAL SERVICES
# =============================================================================
# Image Upload Service (ImgBB or similar)
# IMGBB_API_KEY="your_imgbb_api_key"

# Analytics (if using Google Analytics)
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# =============================================================================
# PRODUCTION CHECKLIST
# =============================================================================
# Before going live, ensure:
# ✅ All environment variables are set with production values
# ✅ Supabase project is created and schema is deployed
# ✅ RLS policies are enabled and configured
# ✅ Razorpay account is activated for live payments
# ✅ Email service is configured and tested
# ✅ Domain is configured with SSL certificate
# ✅ All demo/test components have been removed